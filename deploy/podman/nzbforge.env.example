# Copy to ~/.config/nzbforge/nzbforge.env (rootless) or /etc/nzbforge/nzbforge.env (rootful), chmod 600.
# Plain KEY=value lines only: no quotes, no comments after a value.

# SQLite on the nzbforge-data volume (default). For Postgres:
# DATABASE_URL=postgresql+psycopg://nzb:nzb@db-host/nzbforge
DATABASE_URL=sqlite:////data/nzbforge.db
ADMIN_KEY=change-me-to-a-long-random-string

# Header scanner runs inside the web process: auto = on when NNTP_HOST is set, 1 = always, 0 = off
SCANNER=auto

NNTP_HOST=news.example.com
NNTP_PORT=563
NNTP_SSL=1
NNTP_USER=
NNTP_PASS=

INITIAL_ARTICLES=200000
SCAN_BATCH=10000
SCAN_INTERVAL=300
MIN_COMPLETION=0.90
EXPIRE_DAYS=3

TMDB_API_KEY=
CINEMETA=1
ENRICH_PER_PASS=200
NFO_PER_PASS=100

# Send to downloader (Spotweb-style "Send" button): nzbget or sabnzbd
DOWNLOADER=
DOWNLOADER_URL=
DOWNLOADER_USER=
DOWNLOADER_PASS=
DOWNLOADER_APIKEY=
# DOWNLOADER_CATEGORIES=2000=Movies,5000=Series,3000=Music
# DOWNLOADER_PRIORITY=normal

# Speed: parallel connections (stay under your provider's limit), header compression,
# build releases/metadata every N seconds during long pulls
NNTP_CONNECTIONS=8
NNTP_COMPRESS=1
NNTP_TIMEOUT=60
NNTP_CONNECT_TIMEOUT=30
NNTP_RETRIES=4
NNTP_IDLE_CHECK=20
POSTPROCESS_EVERY=300
ENRICH_EVERY=60
ENRICH_PER_PASS=1000
ENRICH_WORKERS=8
