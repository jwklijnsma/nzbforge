DATABASE_URL=sqlite:///./nzbforge.db
# DATABASE_URL=postgresql+psycopg://nzb:nzb@localhost/nzbforge
ADMIN_KEY=change-me-to-a-long-random-string

SCANNER=auto               # scanner thread inside uvicorn: auto (on if NNTP_HOST set) / 1 / 0
NNTP_HOST=news.example.com
NNTP_PORT=563
NNTP_SSL=1
NNTP_USER=
NNTP_PASS=

INITIAL_ARTICLES=200000   # how far back to start on a new group
SCAN_BATCH=10000
SCAN_INTERVAL=300         # seconds between scan passes
MIN_COMPLETION=0.90       # release when >= this complete and idle 2h
EXPIRE_DAYS=3             # drop incomplete collections after this

# metadata
TMDB_API_KEY=             # optional; movies work without a key via Cinemeta, TV via TVmaze
CINEMETA=1                # free keyless movie (and fallback TV) metadata
ENRICH_PER_PASS=200
NFO_PER_PASS=100

# Send to downloader (Spotweb-style "Send" button): nzbget or sabnzbd
DOWNLOADER=
DOWNLOADER_URL=
DOWNLOADER_USER=
DOWNLOADER_PASS=
DOWNLOADER_APIKEY=
# DOWNLOADER_CATEGORIES=2000=Movies,5000=Series,3000=Music
# DOWNLOADER_PRIORITY=normal   # low/normal/high/veryhigh/force

# Speed
NNTP_CONNECTIONS=8          # parallel connections (stay under your provider's limit)
NNTP_COMPRESS=1
NNTP_TIMEOUT=60
NNTP_CONNECT_TIMEOUT=30             # compressed headers when the provider offers XFEATURE COMPRESS GZIP
POSTPROCESS_EVERY=300       # build releases + metadata every N seconds during long pulls
ENRICH_PER_PASS=1000
ENRICH_WORKERS=8
